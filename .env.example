# Локальная разработка: скопируй в .env (он в .gitignore) и подставь значения,
# затем `set -a; source .env; set +a` перед `go run .`.
# На проде эти значения приходят из Yandex Lockbox (см. deploy/ и md/deploy.md).

# БД (DB_URL в JDBC-формате — Go сам приводит к DSN pgx)
DB_URL=jdbc:postgresql://localhost:5432/sylvieshare
DB_USER=sylvie
DB_PASSWORD=changeme

# Secure-cookie: auto|true|false (локально ставь false, т.к. http)
SESSION_SECURE_COOKIE=false

# S3-совместимое хранилище (Yandex Object Storage)
OBJECT_STORAGE_ENDPOINT=https://storage.yandexcloud.net
OBJECT_STORAGE_REGION=ru-central1
OBJECT_STORAGE_BUCKET=dndshare
OBJECT_STORAGE_PUBLIC_URL=https://storage.yandexcloud.net/dndshare
OBJECT_STORAGE_ACCESS_KEY=changeme
OBJECT_STORAGE_SECRET_KEY=changeme
OBJECT_STORAGE_KEY_PREFIX=images/

# MCP-эндпоинт для AI-агента
MCP_AUTH_TOKEN=dev-mcp-token-change-me
MCP_WRITE_ENABLED=false
