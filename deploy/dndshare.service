[Unit]
Description=dndShare (Go)
After=network-online.target
Wants=network-online.target
# Не молотить бесконечно при падениях (напр. недоступна БД):
# максимум 4 рестарта за 120с, иначе systemd останавливает unit до ручного start.
StartLimitIntervalSec=120
StartLimitBurst=4

[Service]
Type=simple
User=sylvieshare
WorkingDirectory=/home/sylvieshare
Environment=APP_ENV=production
Environment=FRONTEND_ASSET_CACHE_DIR=/home/sylvieshare/dndshare-frontend-assets
Environment=TRUST_PROXY_HEADERS=true
# run.sh тянет секреты из Lockbox через авторизованный ключ сервисного аккаунта,
# грузит env и exec'ает бинарь. ID секрета 'dndshare-secrets' (не секрет):
Environment=LOCKBOX_SECRET_ID=e6qc2l631pr9823st3lg
Environment=LOCKBOX_SERVICE_ACCOUNT_KEY_FILE=/etc/dndshare/lockbox-sa-key.json
# Подключение к БД (не секрет — пароль приходит из Lockbox как DB_PASSWORD).
# DB_URL в JDBC-формате: Go сам приводит его к DSN pgx.
Environment=DB_URL=jdbc:postgresql://rc1d-t6pv758r8anrqimo.mdb.yandexcloud.net:6432/sylvieshare?sslmode=verify-full&sslrootcert=/etc/ssl/certs/yandex-cloud-ca.pem
Environment=DB_USER=sylvie
# HTTP используется только для подготовки; production cookies требуют HTTPS.
Environment=SESSION_SECURE_COOKIE=true
ExecStart=/home/sylvieshare/dndshare-run.sh
Restart=always
RestartSec=15
SuccessExitStatus=143
StandardOutput=append:/home/sylvieshare/dndshare-log.txt
StandardError=append:/home/sylvieshare/dndshare-log.txt

[Install]
WantedBy=multi-user.target
