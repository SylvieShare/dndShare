material {
    name: MapGrid, shadingModel: unlit, blending: transparent, culling: none,
    depthWrite: false, requires: [uv0], flipUV: false,
    parameters: [{type: float2, name: extent}, {type: float3, name: colour}]
}
fragment {
    precision highp float;
    void material(inout MaterialInputs m) {
        prepareMaterial(m);
        vec2 point = getUV0() * materialParams.extent;
        vec2 distance = abs(fract(point + 0.5) - 0.5);
        vec2 width = max(fwidth(point), vec2(0.00001));
        vec2 line = 1.0 - smoothstep(width * 0.15, width * 0.85, distance);
        float opacity = max(line.x, line.y) * 0.25;
        m.baseColor = vec4(materialParams.colour * opacity, opacity);
    }
}
