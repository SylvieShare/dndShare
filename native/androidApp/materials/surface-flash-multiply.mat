material { name: MapSurfaceFlashMultiply, shadingModel:unlit, vertexDomain:device,culling:none,
    depthWrite:false,depthCulling:false,blending:custom,
    blendFunction:{srcRGB:zero,dstRGB:srcColor,srcA:zero,dstA:one},
    parameters:[{type:float,name:brightness}] }
fragment { void material(inout MaterialInputs m) {prepareMaterial(m);m.baseColor=vec4(vec3(materialParams.brightness),1.0);} }
