material { name: MapLoading, shadingModel: unlit, blending: transparent,
    culling: none, depthWrite: false, requires: [uv0],
    parameters: [{type:float,name:time},{type:float,name:opacity},{type:float,name:invalid}] }
fragment { void material(inout MaterialInputs m) {
    prepareMaterial(m);
    vec2 uv=getUV0(), p=uv-0.5;
    float checker=mod(floor(uv.x*8.0)+floor(uv.y*8.0),2.0);
    vec3 colour=mix(vec3(0.22,0.075,0.4),vec3(0.36,0.16,0.62),checker);
    float ring=1.0-smoothstep(0.0,0.02,abs(length(p)-0.2));
    float angle=mod(atan(p.y,p.x)-materialParams.time*3.0+6.283185,6.283185)/6.283185;
    colour=mix(colour,vec3(0.9,0.77,1.0),ring*(0.15+0.85*angle));
    float border=step(0.46,max(abs(p.x),abs(p.y)));
    m.baseColor=vec4(mix(colour,mix(vec3(0.67,0.43,0.96),vec3(1.0,0.2,0.26),materialParams.invalid),border),materialParams.opacity);
} }
