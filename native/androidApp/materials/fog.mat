material { name: MapVolumeFog, shadingModel:unlit, blending:opaque, vertexDomain:device, culling:none,
    depthWrite:false,depthCulling:false,requires:[uv0],flipUV:false,
    parameters:[{type:sampler2d,name:sceneDepth,precision:high},{type:sampler2dArray,name:densityField},{type:sampler2dArray,name:noiseField},
        {type:float4x4,name:inverseViewProjection,precision:high},{type:float3,name:rayDirection},
        {type:float3,name:boundsMin},{type:float3,name:boundsSize},{type:float3,name:fieldSize},
        {type:float3,name:sunDirection},{type:float,name:clock}] }
fragment {
precision highp float;
precision highp sampler2D;
precision highp sampler2DArray;
vec3 unproject(vec2 uv,float depth) {
    vec4 p=materialParams.inverseViewProjection*vec4(uv*2.0-1.0,depth*2.0-1.0,1.0);
    return p.xyz/p.w;
}
float volume(highp sampler2DArray field,vec3 uvw,vec3 size,bool repeatField) {
    vec3 p=repeatField?fract(uvw):clamp(uvw,vec3(0.0),vec3(1.0));
    float z=p.z*size.z-0.5;float low=floor(z),high=low+1.0;
    low=repeatField?mod(low+size.z,size.z):clamp(low,0.0,size.z-1.0);
    high=repeatField?mod(high,size.z):clamp(high,0.0,size.z-1.0);
    return mix(texture(field,vec3(p.xy,low)).r,texture(field,vec3(p.xy,high)).r,fract(z));
}
void material(inout MaterialInputs m) {
    prepareMaterial(m);vec2 uv=getNormalizedViewportCoord().xy;vec3 origin=unproject(uv,0.0),direction=materialParams.rayDirection;
    vec3 invDirection=1.0/mix(vec3(0.000001),direction,step(vec3(0.000001),abs(direction)));
    vec3 ta=(materialParams.boundsMin-origin)*invDirection;
    vec3 tb=(materialParams.boundsMin+materialParams.boundsSize-origin)*invDirection;
    vec3 nearBox=min(ta,tb),farBox=max(ta,tb);
    float entry=max(0.0,max(nearBox.x,max(nearBox.y,nearBox.z)));
    float exit=min(farBox.x,min(farBox.y,farBox.z));
    // Filament stores reversed Z; the public projection uses normal OpenGL clip coordinates.
    float depth=1.0-texture(materialParams_sceneDepth,uv).r;
    exit=min(exit,dot(unproject(uv,depth)-origin,direction));
    if(exit<=entry){m.baseColor=vec4(0.0,0.0,0.0,1.0);return;}
    float stepLength=(exit-entry)/48.0;
    float jitter=fract(sin(dot(gl_FragCoord.xy,vec2(12.9898,78.233)))*43758.5453);
    float t=entry+stepLength*(0.2+0.6*jitter),transmittance=1.0;
    float illumination=0.0;vec3 wind=vec3(materialParams.clock*0.004,materialParams.clock*0.001,materialParams.clock*0.002);
    for(int i=0;i<48;i++) {
        vec3 p=origin+direction*t;
        float shape=volume(materialParams_densityField,(p-materialParams.boundsMin)/materialParams.boundsSize,materialParams.fieldSize,false);
        if(shape>0.005) {
            vec3 uvw=p*0.043+wind;
            float coarse=volume(materialParams_noiseField,uvw,vec3(32.0),true);
            float detail=volume(materialParams_noiseField,uvw*3.17+vec3(0.37,0.11,0.68),vec3(32.0),true);
            float billow=coarse*0.75+detail*0.25;
            vec3 warp=vec3(coarse-0.5,detail-0.5,coarse+detail-1.0)*0.85;
            shape=volume(materialParams_densityField,(p+warp-materialParams.boundsMin)/materialParams.boundsSize,materialParams.fieldSize,false);
            float density=smoothstep(0.02,0.6,shape-(1.0-billow)*0.36)*smoothstep(0.12,0.85,billow);
            float ahead=volume(materialParams_noiseField,uvw+materialParams.sunDirection*0.017,vec3(32.0),true);
            float light=clamp(0.6+(ahead-coarse)*2.8,0.15,1.0);
            float opacity=1.0-exp(-density*stepLength*7.0);
            illumination+=transmittance*opacity*light;transmittance*=1.0-opacity;
            if(transmittance<0.015)break;
        }
        t+=stepLength;
    }
    m.baseColor=vec4(1.0-transmittance,illumination,0.0,1.0);
}
}
