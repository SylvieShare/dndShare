// ACES RRT/ODT fit and matrices match the web shader; no JavaScript runtime is involved.
material {
    name: MapColourOutput, shadingModel:unlit, vertexDomain:device, culling:none,
    depthWrite:false, depthCulling:false, requires:[uv0], flipUV:false,
    parameters:[{type:sampler2d,name:sceneColour},{type:sampler2d,name:sourceColour},
        {type:sampler2d,name:sourceDepth,precision:high},{type:sampler2d,name:fogData},
        {type:float,name:hasFog},{type:float2,name:fogSize},{type:float,name:depthRange},
        {type:float3,name:backgroundColour},{type:sampler2d,name:selectedDepth,precision:high},
        {type:float,name:hasSelection},{type:float2,name:pixelSize},{type:float,name:outlineWidth},{type:float3,name:outlineColour}]
}
fragment {
    precision highp float;
    precision highp sampler2D;
    vec3 aces(vec3 colour) {
        const mat3 inputMatrix=mat3(vec3(0.59719,0.07600,0.02840),vec3(0.35458,0.90834,0.13383),vec3(0.04823,0.01566,0.83777));
        const mat3 outputMatrix=mat3(vec3(1.60475,-0.10208,-0.00327),vec3(-0.53108,1.10813,-0.07276),vec3(-0.07367,-0.00605,1.07602));
        vec3 v=inputMatrix*(colour/0.6);
        vec3 a=v*(v+0.0245786)-0.000090537;
        vec3 b=v*(0.983729*v+0.4329510)+0.238081;
        return clamp(outputMatrix*(a/b),vec3(0.0),vec3(1.0));
    }
    void material(inout MaterialInputs m) {
        prepareMaterial(m);vec2 uv=getNormalizedViewportCoord().xy;
        vec3 colour=texture(materialParams_sceneColour,uv).rgb;
        vec3 original=texture(materialParams_sourceColour,uv).rgb;
        float alpha=0.0;
        if(materialParams.hasFog>0.5) {
            vec2 pixel=uv*materialParams.fogSize-0.5,base=floor(pixel),fraction=fract(pixel);
            float depth=texture(materialParams_sourceDepth,uv).r,total=0.0;
            for(int y=0;y<2;y++)for(int x=0;x<2;x++) {
                vec2 offset=vec2(float(x),float(y)),sampleUV=(base+offset+0.5)/materialParams.fogSize;
                vec2 spatial=mix(1.0-fraction,fraction,offset);
                float delta=abs(texture(materialParams_sourceDepth,sampleUV).r-depth)*materialParams.depthRange;
                float weight=spatial.x*spatial.y*exp(-delta*18.0);
                alpha+=texture(materialParams_fogData,sampleUV).r*weight;total+=weight;
            }
            alpha=total>0.0001?alpha/total:0.0;
        }
        vec3 outputColour=aces(colour);
        if(distance(original,materialParams.backgroundColour)<0.001)
            outputColour+=(materialParams.backgroundColour-aces(materialParams.backgroundColour))*(1.0-alpha);
        if(materialParams.hasSelection>0.5) {
            float inside=step(0.0000001,texture(materialParams_selectedDepth,uv).r),edge=0.0;
            for(int y=-1;y<=1;y++)for(int x=-1;x<=1;x++) {
                vec2 offset=vec2(float(x),float(y))*materialParams.pixelSize*materialParams.outlineWidth;
                edge=max(edge,step(0.0000001,texture(materialParams_selectedDepth,uv+offset).r));
            }
            outputColour=mix(outputColour,materialParams.outlineColour,edge*(1.0-inside));
        }
        m.baseColor=vec4(clamp(outputColour,vec3(0.0),vec3(1.0)),1.0);
    }
}
