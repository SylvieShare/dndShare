{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test:mechanics:contracts": "vitest run tests/game-mechanics/derived.test.js tests/game-mechanics/editor.test.js tests/game-mechanics/status.test.js tests/game-mechanics/effect-bindings.test.js && node scripts/character-rules-fixtures.mjs --check",
    "build": "npm run check:design && npm run check:bindings && npm run check:colors && vite build && npm run check:bundle",
    "check:bindings": "eslint src",
    "check:colors": "node scripts/check-colors.mjs",
    "preview": "vite preview",
    "test": "npm run check:design && npm run check:bindings && node --test scripts/check-bundle.test.mjs scripts/design-media.test.mjs scripts/check-design.test.mjs && vitest run src",
    "test:visual": "playwright test --project=ui tests/visual",
    "check:bundle": "node scripts/check-bundle.mjs",
    "benchmark": "node scripts/benchmark-frontend.mjs",
    "test:performance": "playwright test --project=ui tests/performance",
    "test:browser": "playwright test -c playwright.suite.config.js",
    "test:models": "DNDSHARE_TEST_MODELS=1 playwright test -c playwright.suite.config.js --project=models",
    "check:design": "node scripts/check-design.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/core": "8.6.0",
    "@lucide/vue": "^1.72.0",
    "@sylvieshare/share-ui": "https://github.com/SylvieShare/share-ui/archive/refs/tags/v0.60.0.tar.gz",
    "@vue/devtools-api": "^8.2.1",
    "html-to-image": "1.11.13",
    "pinia": "^4.1.0",
    "three": "0.187.0",
    "three-mesh-bvh": "0.9.18",
    "vue": "^3.5.45",
    "vue-router": "^5.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.1",
    "fflate": "0.8.3",
    "globals": "^17.14.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": "^24.0.0"
  },
  "overrides": {
    "@eslint/config-array": {
      "minimatch": "^11.0.8"
    },
    "eslint": {
      "minimatch": "^11.0.8"
    }
  }
}
